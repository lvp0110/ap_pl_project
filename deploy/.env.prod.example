# Окружение прод-контейнера. Живёт на сервере в $DEPLOY_DIR/.env.prod,
# chmod 600, в git не попадает.
#
#   cp deploy/.env.prod.example .env.prod && chmod 600 .env.prod

# ConstrTodo, куда server.js проксирует /login, /auth/*, /crm/*.
# Пока CRM-API (ветка feat/crm) не выкачен, /crm будет отдавать 404 —
# фронт поднимется, но справочники и проекты не заработают.
UPSTREAM_URL=https://dev3.constrtodo.ru:3005

# PORT и DIST_DIR задаются в docker-compose.prod.yml, здесь их не дублируем.
# HOST задавать нельзя: внутри контейнера нужен bind на 0.0.0.0.
