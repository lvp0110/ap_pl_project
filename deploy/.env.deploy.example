# Локальная конфигурация деплоя. Скопируйте в deploy/.env.deploy (gitignored).
#
#   cp deploy/.env.deploy.example deploy/.env.deploy

DEPLOY_HOST=leonidl@51.250.51.86
DEPLOY_DIR=/home/leonidl/ap_pl_project
DEPLOY_DOMAIN=crmakyfon.constrtodo.ru

# Общий wildcard *.constrtodo.ru (GlobalSign). Certbot не нужен.
DEPLOY_CERT_DIR=/home/leonidl/certs

# У алиаса test_server/dev3 в ~/.ssh/config нет IdentityFile — указываем ключ явно.
# Публичная часть лежит в authorized_keys на сервере, приватная — в секрете
# DEPLOY_SSH_KEY для GitHub Actions.
DEPLOY_SSH_KEY_FILE=~/.ssh/crmakyfon_deploy

DEPLOY_REMOTE=origin
DEPLOY_REV=origin/main
